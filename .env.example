# ============================================
# FIREBASE - Configuração do Projeto
# ============================================
# Obtenha estes valores em: Firebase Console -> Configurações do Projeto -> Geral -> Seus apps -> Web
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=""
# (default) para o banco padrão, ou o ID do banco Firestore customizado
NEXT_PUBLIC_FIREBASE_DATABASE_ID="(default)"

# ============================================
# GEMINI AI - Classificação de Relatos
# ============================================
# Obtenha em: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""

# ============================================
# UPSTASH REDIS - Rate Limiting (Opcional)
# ============================================
# Obtenha em: https://console.upstash.com
# Se não configurado, usa rate limiter in-memory (dev local)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ============================================
# APP - URL de Deploy
# ============================================
APP_URL="http://localhost:3000"
