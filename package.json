{
  "name": "conecta-santa-maria",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "firebase:rules:check": "firebase deploy --only firestore:rules --project conectasantamaria-pa --dry-run",
    "firebase:rules:deploy": "firebase deploy --only firestore:rules --project conectasantamaria-pa",
    "firebase:indexes:check": "firebase deploy --only firestore:indexes --project conectasantamaria-pa --dry-run",
    "firebase:indexes:deploy": "firebase deploy --only firestore:indexes --project conectasantamaria-pa",
    "firebase:storage:check": "firebase deploy --only storage --project conectasantamaria-pa --dry-run",
    "firebase:storage:deploy": "firebase deploy --only storage --project conectasantamaria-pa",
    "firebase:functions:build": "npm --prefix functions run build",
    "firebase:functions:deploy": "firebase deploy --only functions --project conectasantamaria-pa",
    "firebase:seed": "ts-node scripts/seed.ts",
    "emulators": "firebase emulators:start --only firestore,auth,functions,storage",
    "test": "jest",
    "test:watch": "jest --watch",
    "analyze": "ANALYZE=true next build",
    "lighthouse": "lighthouse http://localhost:3000 --output=html --output-path=./lighthouse-report.html --chrome-flags=\"--headless --no-sandbox\"",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@sentry/nextjs": "^10.65.0",
    "@upstash/ratelimit": "^2.0.0",
    "@upstash/redis": "^1.34.0",
    "ajv": "^8.20.0",
    "clsx": "^2.0.0",
    "firebase": "^12.12.1",
    "jose": "^6.0.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.9.0",
    "motion": "^11.0.0",
    "next": "^16.2.9",
    "next-intl": "^4.13.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^9.0.0",
    "tailwind-merge": "^2.0.0"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.2.1",
    "@next/bundle-analyzer": "^16.2.10",
    "@playwright/test": "^1.61.1",
    "@storybook/addon-a11y": "^10.5.0",
    "@storybook/addon-docs": "^10.5.0",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/addon-interactions": "^8.6.14",
    "@storybook/addon-mcp": "^0.7.0",
    "@storybook/addon-onboarding": "^10.5.0",
    "@storybook/addon-vitest": "^10.5.0",
    "@storybook/nextjs": "^10.5.0",
    "@storybook/nextjs-vite": "^10.5.0",
    "@storybook/react": "^10.5.0",
    "@tailwindcss/postcss": "^4.2.4",
    "@types/jest": "^30.0.0",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^20.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.5.0",
    "dotenv": "^17.4.2",
    "eslint": "^8.0.0",
    "eslint-config-next": "^16.0.0",
    "eslint-plugin-storybook": "^10.5.0",
    "firebase-admin": "^12.7.0",
    "firebase-tools": "^15.19.1",
    "jest": "^30.4.2",
    "lighthouse": "^13.4.0",
    "playwright": "^1.60.0",
    "postcss": "^8.5.10",
    "storybook": "^10.5.0",
    "tailwindcss": "^4.2.4",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "typescript": "^5.0.0",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "postcss": "$postcss"
  }
}
