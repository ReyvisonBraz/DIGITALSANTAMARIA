rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function adminDoc() {
      return get(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isStaff() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
        adminDoc().data.role in ['admin', 'clerk'];
    }

    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
        adminDoc().data.role == 'admin';
    }

    function validDemandCreate() {
      return incoming().status == 'pending'
        && incoming().consent == true
        && incoming().isAnonymous is bool
        && (
          (incoming().isAnonymous == true && incoming().authorId == '')
          || (incoming().isAnonymous == false && incoming().authorId == request.auth.uid)
        );
    }

    function validPetitionSignatureUpdate() {
      return isSignedIn()
        && incoming().diff(existing()).changedKeys().hasOnly(['signaturesCount', 'updatedAt'])
        && incoming().signaturesCount == existing().signaturesCount + 1;
    }

    match /{document=**} {
      allow read, write: if false;
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isStaff();
      allow create: if isOwner(userId)
        && incoming().uid == userId
        && incoming().role == 'citizen';
      allow update: if (
          isOwner(userId)
          && incoming().uid == existing().uid
          && incoming().role == existing().role
        ) || isStaff();
    }

    match /admins/{uid} {
      // Cidadão precisa poder ler seu próprio doc para descobrir se é staff.
      // Se o doc não existir, o cliente trata como 'citizen'.
      allow get: if isOwner(uid) || isStaff();
      allow list: if isStaff();
      allow create, update, delete: if isAdmin();
    }

    match /reports/{reportId} {
      allow read: if isOwner(resource.data.reporterId) || isStaff();
      allow list: if isSignedIn();
      allow create: if isSignedIn()
        && incoming().reporterId == request.auth.uid
        && incoming().status == 'pending';
      allow update: if isStaff();
    }

    match /demands/{demandId} {
      allow read: if isStaff()
        || isOwner(resource.data.authorId)
        || resource.data.isAnonymous == true;
      allow create: if isSignedIn() && validDemandCreate();
      allow update: if isStaff();
      allow delete: if isAdmin();
    }

    match /petitions/{petitionId} {
      allow read: if true;
      allow create: if isSignedIn()
        && incoming().creatorId == request.auth.uid
        && incoming().signaturesCount == 0
        && incoming().status == 'active';
      allow update: if isOwner(resource.data.creatorId)
        || isStaff()
        || validPetitionSignatureUpdate();
      allow delete: if isAdmin();
    }

    match /petition_signatures/{sigId} {
      allow read: if true;
      allow create: if isSignedIn()
        && incoming().userId == request.auth.uid
        && sigId == incoming().petitionId + '_' + request.auth.uid;
      allow update, delete: if false;
    }

    match /appointments/{appointmentId} {
      allow read: if isOwner(resource.data.userId) || isStaff();
      allow create: if isSignedIn()
        && incoming().userId == request.auth.uid
        && incoming().status == 'scheduled';
      allow update: if (isOwner(resource.data.userId) && incoming().status == 'cancelled') || isStaff();
    }

    match /health_units/{unitId} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /enrollments/{enrollmentId} {
      allow read: if isOwner(resource.data.userId) || isStaff();
      allow create: if isSignedIn()
        && incoming().userId == request.auth.uid
        && incoming().status == 'pending';
      allow update, delete: if isStaff();
    }

    match /jobs/{jobId} {
      allow read: if true;
      allow create: if isSignedIn()
        && incoming().employerId == request.auth.uid;
      allow update: if isOwner(resource.data.employerId) || isStaff();
      allow delete: if isAdmin();
    }

    match /job_applications/{appId} {
      allow read: if isOwner(resource.data.applicantId) || isStaff();
      allow create: if isSignedIn()
        && incoming().applicantId == request.auth.uid
        && incoming().status == 'applied';
      allow update: if isStaff();
    }

    match /emergency_alerts/{alertId} {
      allow read: if isStaff();
      allow create: if isSignedIn()
        && incoming().userId == request.auth.uid
        && incoming().status == 'active';
      allow update: if isStaff();
    }

    match /notifications/{notificationId} {
      allow get: if isOwner(resource.data.recipientId);
      allow list: if isSignedIn();
      allow create: if isStaff();
      allow update: if isOwner(resource.data.recipientId)
        && incoming().diff(existing()).affectedKeys().hasOnly(['read'])
        && incoming().read == true;
      allow delete: if false;
    }

    // Conteúdo publicado pela prefeitura — leitura pública, escrita só staff.
    // Cobre as 12 coleções consumidas pelas páginas de serviço (useContent).
    match /notices/{id}            { allow read: if true; allow write: if isStaff(); }
    match /events/{id}             { allow read: if true; allow write: if isStaff(); }
    match /community_groups/{id}   { allow read: if true; allow write: if isStaff(); }
    // Comércio Local — admin cria direto e cidadão pode auto-cadastrar (entra como pending_approval).
    match /businesses/{id} {
      allow read, list: if true;
      allow create: if isStaff()
        || (isSignedIn()
            && incoming().ownerId == request.auth.uid
            && incoming().status == 'pending_approval');
      allow update: if isStaff()
        || (isOwner(resource.data.ownerId)
            && incoming().ownerId == existing().ownerId
            && incoming().status == existing().status);
      allow delete: if false;
    }
    match /safety_zones/{id}       { allow read: if true; allow write: if isStaff(); }
    match /environment_data/{id}   { allow read: if true; allow write: if isStaff(); }
    match /social_programs/{id}    { allow read: if true; allow write: if isStaff(); }
    match /tax_records/{id}        { allow read: if true; allow write: if isStaff(); }
    match /traffic_alerts/{id}     { allow read: if true; allow write: if isStaff(); }
    match /polls/{id}              { allow read: if true; allow write: if isStaff(); }
    match /public_services/{id}    { allow read: if true; allow write: if isStaff(); }
    match /works/{id}              { allow read: if true; allow write: if isStaff(); }
  }
}
