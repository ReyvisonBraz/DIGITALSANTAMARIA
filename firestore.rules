rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function adminDoc() {
      return get(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isStaff() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
        adminDoc().data.role in ['admin', 'clerk'];
    }

    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
        adminDoc().data.role == 'admin';
    }

    function validDemandCreate() {
      return incoming().status == 'pending'
        && incoming().consent == true
        && incoming().isAnonymous is bool
        && (
          (incoming().isAnonymous == true && incoming().authorId == '')
          || (incoming().isAnonymous == false && incoming().authorId == request.auth.uid)
        );
    }

    function validDemandCitizenConversationUpdate() {
      return isOwner(existing().authorId)
        && existing().isAnonymous == false
        && incoming().diff(existing()).affectedKeys().hasOnly(['conversation', 'updatedAt'])
        && incoming().conversation.keys().hasOnly([
          'lastMessageAt',
          'lastMessageAuthorName',
          'lastMessageAuthorRole',
          'unreadByCitizen',
          'unreadByStaff'
        ])
        && incoming().conversation.lastMessageAuthorRole == 'citizen'
        && incoming().conversation.unreadByCitizen == false
        && incoming().conversation.unreadByStaff == true;
    }

    function validDemandCitizenReadUpdate() {
      return isOwner(existing().authorId)
        && existing().isAnonymous == false
        && incoming().diff(existing()).affectedKeys().hasOnly(['conversation', 'updatedAt'])
        && incoming().conversation.diff(existing().conversation).affectedKeys().hasOnly(['unreadByCitizen'])
        && incoming().conversation.unreadByCitizen == false;
    }

    function validReportCitizenConversationUpdate() {
      return isOwner(existing().reporterId)
        && incoming().diff(existing()).affectedKeys().hasOnly(['conversation', 'updatedAt'])
        && incoming().conversation.keys().hasOnly([
          'lastMessageAt',
          'lastMessageAuthorName',
          'lastMessageAuthorRole',
          'unreadByCitizen',
          'unreadByStaff'
        ])
        && incoming().conversation.lastMessageAuthorRole == 'citizen'
        && incoming().conversation.unreadByCitizen == false
        && incoming().conversation.unreadByStaff == true;
    }

    function validReportCitizenReadUpdate() {
      return isOwner(existing().reporterId)
        && incoming().diff(existing()).affectedKeys().hasOnly(['conversation', 'updatedAt'])
        && incoming().conversation.diff(existing().conversation).affectedKeys().hasOnly(['unreadByCitizen'])
        && incoming().conversation.unreadByCitizen == false;
    }

    function validReportOwnerCancel() {
      return isOwner(existing().reporterId)
        && existing().status in ['pending', 'in_review']
        && incoming().status == 'cancelled'
        && incoming().cancellation.cancelledBy == request.auth.uid
        && incoming().cancellation.cancelledAt is timestamp
        && (
          incoming().cancellation.reason == null
          || incoming().cancellation.reason is string
        )
        && incoming().cancellation.keys().hasOnly(['cancelledAt', 'cancelledBy', 'reason'])
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'cancellation', 'updatedAt']);
    }

    function validAppointmentOwnerCancel() {
      return isOwner(resource.data.userId)
        && incoming().status == 'cancelled'
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']);
    }

    function validUserOwnerUpdate() {
      return incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName',
          'photoURL',
          'neighborhood',
          'phone',
          'updatedAt'
        ]);
    }

    function validPetitionCreate() {
      return incoming().creatorId == request.auth.uid
        && incoming().signaturesCount == 0
        && incoming().status == 'active'
        && incoming().officialReply == null
        && incoming().keys().hasOnly([
          'creatorId',
          'creatorName',
          'creatorPhotoURL',
          'title',
          'description',
          'category',
          'goal',
          'signaturesCount',
          'status',
          'officialReply',
          'coverImageURL',
          'createdAt',
          'updatedAt'
        ]);
    }

    function validBusinessCitizenCreate() {
      return incoming().ownerId == request.auth.uid
        && incoming().status == 'pending_approval'
        && incoming().deletedAt == null
        && incoming().reviewNote == null
        && incoming().keys().hasOnly([
          'title',
          'description',
          'status',
          'category',
          'address',
          'phone',
          'whatsapp',
          'hours',
          'imageURL',
          'mapURL',
          'isOpen',
          'lat',
          'lng',
          'ownerId',
          'ownerName',
          'reviewNote',
          'createdAt',
          'updatedAt',
          'deletedAt'
        ]);
    }

    function validBusinessOwnerUpdate() {
      return isOwner(resource.data.ownerId)
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'title',
          'description',
          'category',
          'address',
          'phone',
          'whatsapp',
          'hours',
          'imageURL',
          'mapURL',
          'isOpen',
          'updatedAt'
        ]);
    }

    function validDemandOwnerCancel() {
      return isOwner(existing().authorId)
        && existing().isAnonymous == false
        && existing().status in ['pending', 'analyzing']
        && incoming().status == 'cancelled'
        && incoming().cancellation.cancelledBy == request.auth.uid
        && incoming().cancellation.cancelledAt is timestamp
        && (
          incoming().cancellation.reason == null
          || incoming().cancellation.reason is string
        )
        && incoming().cancellation.keys().hasOnly(['cancelledAt', 'cancelledBy', 'reason'])
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'cancellation', 'updatedAt']);
    }

    function validBusinessOwnerResubmit() {
      return isOwner(resource.data.ownerId)
        && existing().status == 'archived'
        && incoming().status == 'pending_approval'
        && incoming().reviewNote == null
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'title',
          'description',
          'category',
          'address',
          'phone',
          'whatsapp',
          'hours',
          'imageURL',
          'mapURL',
          'isOpen',
          'status',
          'reviewNote',
          'updatedAt'
        ]);
    }

    function validBusinessOwnerDelete() {
      return isOwner(resource.data.ownerId)
        && incoming().status == 'archived'
        && incoming().deletedAt is timestamp
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'status',
          'reviewNote',
          'deletedAt',
          'updatedAt'
        ]);
    }

    match /{document=**} {
      allow read, write: if false;
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId)
        && incoming().uid == userId
        && incoming().role == 'citizen';
      allow update: if (isOwner(userId) && validUserOwnerUpdate()) || isAdmin();
    }

    match /admins/{uid} {
      // Cidadão precisa poder ler seu próprio doc para descobrir se é staff.
      // Se o doc não existir, o cliente trata como 'citizen'.
      allow get: if isOwner(uid) || isStaff();
      allow list: if isStaff();
      allow create, update, delete: if isAdmin();
    }

    match /reports/{reportId} {
      allow read: if isOwner(resource.data.reporterId) || isStaff();
      allow create: if isSignedIn()
        && incoming().reporterId == request.auth.uid
        && incoming().status == 'pending';
      allow update: if isStaff()
        || validReportCitizenConversationUpdate()
        || validReportCitizenReadUpdate()
        || validReportOwnerCancel();
    }

    match /report_messages/{messageId} {
      allow read: if isStaff()
        || isOwner(get(/databases/$(database)/documents/reports/$(resource.data.reportId)).data.reporterId);
      allow create: if isStaff()
        || (
          isSignedIn()
          && incoming().authorId == request.auth.uid
          && incoming().authorRole == 'citizen'
          && get(/databases/$(database)/documents/reports/$(incoming().reportId)).data.reporterId == request.auth.uid
        );
      allow update, delete: if false;
    }

    match /demands/{demandId} {
      allow read: if isStaff()
        || isOwner(resource.data.authorId)
        || resource.data.isAnonymous == true;
      allow create: if isSignedIn() && validDemandCreate();
      allow update: if isStaff()
        || validDemandCitizenConversationUpdate()
        || validDemandCitizenReadUpdate()
        || validDemandOwnerCancel();
      allow delete: if isAdmin();
    }

    match /demand_messages/{messageId} {
      allow read: if isStaff()
        || isOwner(get(/databases/$(database)/documents/demands/$(resource.data.demandId)).data.authorId)
        || get(/databases/$(database)/documents/demands/$(resource.data.demandId)).data.isAnonymous == true;
      allow create: if isStaff()
        || (
          isSignedIn()
          && incoming().authorId == request.auth.uid
          && incoming().authorRole == 'citizen'
          && get(/databases/$(database)/documents/demands/$(incoming().demandId)).data.authorId == request.auth.uid
        );
      allow update, delete: if false;
    }

    match /petitions/{petitionId} {
      allow read: if true;
      allow create: if isSignedIn() && validPetitionCreate();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /petition_signatures/{sigId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && incoming().userId == request.auth.uid
        && sigId == incoming().petitionId + '_' + request.auth.uid;
      allow update, delete: if false;
    }

    match /appointments/{appointmentId} {
      allow read: if isOwner(resource.data.userId) || isStaff();
      allow create: if isSignedIn()
        && incoming().userId == request.auth.uid
        && incoming().status == 'scheduled';
      allow update: if validAppointmentOwnerCancel() || isStaff();
    }

    match /health_units/{unitId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /enrollments/{enrollmentId} {
      allow read: if isOwner(resource.data.userId) || isStaff();
      allow create: if isSignedIn()
        && incoming().userId == request.auth.uid
        && incoming().status == 'pending';
      allow update, delete: if isStaff();
    }

    match /jobs/{jobId} {
      allow read: if true;
      allow create: if isSignedIn()
        && incoming().employerId == request.auth.uid;
      allow update: if isOwner(resource.data.employerId) || isAdmin();
      allow delete: if isAdmin();
    }

    match /job_applications/{appId} {
      allow read: if isOwner(resource.data.applicantId) || isStaff();
      allow create: if isSignedIn()
        && incoming().applicantId == request.auth.uid
        && incoming().status == 'applied';
      allow update: if isStaff();
    }

    match /emergency_alerts/{alertId} {
      allow read: if isOwner(resource.data.userId) || isStaff();
      allow create: if isSignedIn()
        && incoming().userId == request.auth.uid
        && incoming().status == 'active';
      allow update: if isStaff();
    }

    match /notifications/{notificationId} {
      allow get: if isOwner(resource.data.recipientId);
      allow list: if isSignedIn();
      allow create: if isStaff();
      allow update: if isOwner(resource.data.recipientId)
        && incoming().diff(existing()).affectedKeys().hasOnly(['read'])
        && incoming().read == true;
      allow delete: if false;
    }

    match /admin_audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isStaff();
      allow update, delete: if false;
    }

    // Conteudo publicado pela prefeitura: leitura publica, escrita so admin.
    // Cobre as 12 colecoes consumidas pelas paginas de servico (useContent).
    match /notices/{id}            { allow read: if true; allow write: if isAdmin(); }
    match /events/{id}             { allow read: if true; allow write: if isAdmin(); }
    match /community_groups/{id}   { allow read: if true; allow write: if isAdmin(); }

    // Comercio Local: admin cria direto e cidadao pode auto-cadastrar como pending_approval.
    match /businesses/{id} {
      allow read, list: if true;
      allow create: if isAdmin()
        || (isSignedIn() && validBusinessCitizenCreate());
      allow update: if isAdmin()
        || validBusinessOwnerUpdate()
        || validBusinessOwnerResubmit()
        || validBusinessOwnerDelete();
      allow delete: if false;
    }

    match /safety_zones/{id}       { allow read: if true; allow write: if isAdmin(); }
    match /environment_data/{id}   { allow read: if true; allow write: if isAdmin(); }
    match /social_programs/{id}    { allow read: if true; allow write: if isAdmin(); }
    match /tax_records/{id}        { allow read: if true; allow write: if isAdmin(); }
    match /traffic_alerts/{id}     { allow read: if true; allow write: if isAdmin(); }
    match /polls/{id}              { allow read: if true; allow write: if isAdmin(); }
    match /public_services/{id}    { allow read: if true; allow write: if isAdmin(); }
    match /pharmacy_items/{id}     { allow read: if true; allow write: if isAdmin(); }
    match /works/{id}              { allow read: if true; allow write: if isAdmin(); }
    match /education_schools/{id}  { allow read: if true; allow write: if isAdmin(); }
  }
}
