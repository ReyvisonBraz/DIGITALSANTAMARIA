{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "Public and private citizen profile information.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "cpf": { "type": "string" },
        "isVerified": { "type": "boolean" },
        "role": { "type": "string", "enum": ["citizen", "admin"] },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["userId", "email", "createdAt", "updatedAt"]
    },
    "Report": {
      "title": "Digital Report",
      "description": "User reported issues (potholes, lights, eco).",
      "type": "object",
      "properties": {
        "reporterId": { "type": "string" },
        "type": { "type": "string", "enum": ["infrastructure", "environment", "security", "other"] },
        "description": { "type": "string" },
        "location": {
          "type": "object",
          "properties": {
            "lat": { "type": "number" },
            "lng": { "type": "number" },
            "address": { "type": "string" }
          }
        },
        "imageUrl": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "in_progress", "resolved", "rejected"] },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["reporterId", "type", "description", "status", "createdAt", "updatedAt"]
    },
    "Appointment": {
      "title": "Health / Social Appointment",
      "description": "Scheduled appointments.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "type": { "type": "string", "enum": ["health", "social", "other"] },
        "unitId": { "type": "string" },
        "date": { "type": "string" },
        "status": { "type": "string", "enum": ["scheduled", "completed", "cancelled"] },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["userId", "type", "unitId", "date", "status", "createdAt", "updatedAt"]
    },
    "Job": {
      "title": "Available Job",
      "description": "Job listing on the municipal portal.",
      "type": "object",
      "properties": {
        "employerId": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "salary": { "type": "string" },
        "location": { "type": "string" },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["employerId", "title", "description", "isActive", "createdAt", "updatedAt"]
    },
    "JobApplication": {
      "title": "Job Application",
      "description": "Application to a job.",
      "type": "object",
      "properties": {
        "jobId": { "type": "string" },
        "applicantId": { "type": "string" },
        "status": { "type": "string", "enum": ["applied", "reviewed", "interview", "rejected", "hired"] },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["jobId", "applicantId", "status", "createdAt", "updatedAt"]
    },
    "EmergencyAlert": {
      "title": "Emergency Alert",
      "description": "SOS or neighborhood alert.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "type": { "type": "string", "enum": ["sos", "neighborhood"] },
        "location": {
          "type": "object",
          "properties": {
            "lat": { "type": "number" },
            "lng": { "type": "number" }
          }
        },
        "description": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "resolved"] },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["userId", "type", "location", "status", "createdAt", "updatedAt"]
    },
    "Petition": {
        "title": "Petition",
        "description": "Citizen petition.",
        "type": "object",
        "properties": {
            "creatorId": { "type": "string" },
            "title": { "type": "string" },
            "description": { "type": "string" },
            "goal": { "type": "number" },
            "signaturesCount": { "type": "number" },
            "status": { "type": "string", "enum": ["active", "achieved", "closed"] },
            "createdAt": { "type": "number" },
            "updatedAt": { "type": "number" }
        },
        "required": ["creatorId", "title", "description", "goal", "signaturesCount", "status", "createdAt", "updatedAt"]
    },
    "PetitionSignature": {
        "title": "Petition Signature",
        "description": "A signature for a petition, preventing duplicates.",
        "type": "object",
        "properties": {
            "petitionId": { "type": "string" },
            "userId": { "type": "string" },
            "createdAt": { "type": "number" }
        },
        "required": ["petitionId", "userId", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profiles."
    },
    "/reports/{reportId}": {
      "schema": { "$ref": "#/entities/Report" },
      "description": "Issues reported by citizens."
    },
    "/appointments/{appointmentId}": {
      "schema": { "$ref": "#/entities/Appointment" },
      "description": "Scheduled health and social appointments."
    },
    "/jobs/{jobId}": {
      "schema": { "$ref": "#/entities/Job" },
      "description": "Job listings from registered employers."
    },
    "/job_applications/{applicationId}": {
      "schema": { "$ref": "#/entities/JobApplication" },
      "description": "Applications submitted to jobs."
    },
    "/emergency_alerts/{alertId}": {
      "schema": { "$ref": "#/entities/EmergencyAlert" },
      "description": "SOS and neighborhood security alerts."
    },
    "/petitions/{petitionId}": {
      "schema": { "$ref": "#/entities/Petition" },
      "description": "Citizen petitions."
    },
    "/petition_signatures/{signatureId}": {
      "schema": { "$ref": "#/entities/PetitionSignature" },
      "description": "Signatures for petitions to prevent duplicates."
    }
  }
}
